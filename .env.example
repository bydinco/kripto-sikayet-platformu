POSTGRES_USER=postgres
# Local dev default (docker-compose.yml) is fine as-is since these ports
# are now bound to 127.0.0.1 only. For docker-compose.prod.yml, this MUST
# be a real random value — that file has no fallback default at all and
# refuses to start without it.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=kripto_sikayet

# Host-side ports, changed from the Postgres/Redis defaults to avoid clashing
# with other projects' containers on this machine.
HOST_POSTGRES_PORT=5434
HOST_REDIS_PORT=6380

# Dedicated e2e test database (separate container, separate volume from the
# dev DB above) — apps/api's e2e suite resets this schema on every run.
POSTGRES_TEST_DB=kripto_sikayet_test
HOST_POSTGRES_TEST_PORT=5435
