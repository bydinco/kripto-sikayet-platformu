{
  "name": "kripto-sikayet-platformu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && eslint e2e-smoke",
    "typecheck": "pnpm --filter api exec tsc --noEmit -p tsconfig.build.json && pnpm --filter web exec tsc --noEmit && tsc --noEmit -p e2e-smoke/tsconfig.json",
    "test": "pnpm -r test",
    "test:smoke": "playwright test --config=e2e-smoke/playwright.config.ts",
    "prisma:validate": "pnpm --filter api exec prisma validate",
    "prisma:migrate": "pnpm --filter api exec prisma migrate dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
