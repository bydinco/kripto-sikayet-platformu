NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/kripto_sikayet?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=3001
WEB_ORIGIN="http://localhost:3002"
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-random-32-byte-hex-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Shared Domain= for the refreshToken and session_hint cookies. Leave empty
# for local dev (host-only cookie works since api/web both run on
# "localhost", just different ports — cookies ignore port). In production,
# where api and web are on separate subdomains (e.g. api.example.com and
# www.example.com), set this to the shared parent domain ("example.com") so
# session_hint — set by the API — is also readable by document.cookie on
# the web app's own subdomain.
COOKIE_DOMAIN=
