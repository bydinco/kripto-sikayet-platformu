NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/kripto_sikayet?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=3001
WEB_ORIGIN="http://localhost:3002"
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-random-32-byte-hex-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Shared Domain= for the refreshToken and session_hint cookies. Leave empty
# for local dev (host-only cookie works since api/web both run on
# "localhost", just different ports — cookies ignore port). In production,
# where api and web are on separate subdomains (e.g. api.example.com and
# www.example.com), set this to the shared parent domain ("example.com") so
# session_hint — set by the API — is also readable by document.cookie on
# the web app's own subdomain.
COOKIE_DOMAIN=

# On-demand revalidation: must match the web app's REVALIDATE_SECRET (sent
# as the x-revalidate-secret header to WEB_ORIGIN/api/revalidate). Leave
# unset to disable — RevalidateService then logs and no-ops instead of
# making a request.
REVALIDATE_SECRET=

# CoinGecko price feed (price band + entity "Piyasa" box; never feeds the
# risk score). Leave COINGECKO_API_KEY unset to keep the feature fully off
# (no requests, no data shown — never fabricated). CHECK COINGECKO'S
# PLAN/TERMS OF USE BEFORE GOING LIVE WITH THIS — commercial-use terms for
# the public API are not settled in this codebase.
COINGECKO_API_KEY=
# "x-cg-demo-api-key" for the free Demo plan, "x-cg-pro-api-key" + base URL
# https://pro-api.coingecko.com/api/v3 for a paid Pro plan.
COINGECKO_API_HEADER=x-cg-demo-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# How often the single server-side refresh job fetches /coins/markets for
# every published coin at once (never per-visitor).
MARKET_REFRESH_INTERVAL_SECONDS=120
# Cached price older than this is treated as unavailable and hidden rather
# than shown stale.
MARKET_STALE_THRESHOLD_MINUTES=15
