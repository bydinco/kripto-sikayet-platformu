{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    // multer: not imported anywhere directly (Nest's FileInterceptor wraps
    // it), but @types/multer's `declare global { namespace Express {...} }`
    // augmentation (Express.Multer.File) is otherwise silently dropped by
    // this restricted `types` list.
    "types": ["vitest/globals", "node", "multer"]
  }
}
