NODE_ENV=test
# Dedicated e2e test database — never the dev DB (see docker-compose.yml's
# postgres_test service). apps/api/test/global-setup.e2e.ts refuses to run
# unless this contains "_test", and resets this schema on every e2e run.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/kripto_sikayet_test?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:3002"
# Test-only value, not a real secret — fine to commit.
JWT_ACCESS_SECRET="test-only-secret-do-not-use-in-prod-0123456789ab"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Same container the dev env uses (docker-compose's redis service, host port
# 6380) — the market e2e suite uses the real client, not a mock.
REDIS_URL="redis://localhost:6380"
# Left unset here on purpose: the default e2e run exercises the
# "no API key -> feature off" path. Individual test files that need the
# feature on set process.env.COINGECKO_API_KEY before createTestApp(), same
# pattern as REVALIDATE_SECRET in revalidate.e2e-spec.ts.
COINGECKO_API_KEY=
