NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3002"
# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Checked
# by POST /api/revalidate against the x-revalidate-secret header. Must
# match apps/api's REVALIDATE_SECRET.
REVALIDATE_SECRET="replace-with-a-random-secret"
